# Keep the real values in ~/.config/honeycomb-monitor/env, never in this repo.
# Optional Telegram destination.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-private-chat-id

# Android push destination. Copy the Firebase Admin SDK service-account JSON
# file to a private location on Ubuntu and set its absolute path here.
FCM_SERVICE_ACCOUNT_FILE=/home/your-user/.config/honeycomb-monitor/firebase-service-account.json
# This must exactly match android/app/src/main/res/values/strings.xml.
FCM_TOPIC=honeycomb-family-alerts-v1

# Optional: use a different directory for the persistent signed-in browser profile.
# HONEYCOMB_MONITOR_PROFILE_DIR=/home/your-user/.local/share/honeycomb-monitor/browser-profile
