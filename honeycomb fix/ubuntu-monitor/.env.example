# Keep the real values in ~/.config/honeycomb-monitor/env, never in this repo.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-private-chat-id

# Optional: use a different directory for the persistent signed-in browser profile.
# HONEYCOMB_MONITOR_PROFILE_DIR=/home/your-user/.local/share/honeycomb-monitor/browser-profile
